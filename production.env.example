EXPO_PUBLIC_SUPABASE_URL={{YOUR_SUPABASE_URL}}
EXPO_PUBLIC_SUPABASE_ANON_KEY={{YOUR_SUPABASE_ANON_KEY}}
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://{{YOUR_DOMAIN}}/privacy.html
EXPO_PUBLIC_ACCOUNT_DELETION_URL=https://{{YOUR_DOMAIN}}/delete-account.html
EXPO_PUBLIC_SUPPORT_EMAIL={{SUPPORT_EMAIL}}
EXPO_PUBLIC_APP_ENV=production

# Optional only if intentionally enabling Sentry:
# EXPO_PUBLIC_SENTRY_DSN={{SENTRY_DSN}}
# SENTRY_ORG={{SENTRY_ORG}}
# SENTRY_PROJECT={{SENTRY_PROJECT}}
# SENTRY_AUTH_TOKEN={{SENTRY_AUTH_TOKEN}}
